PORT=3000
NODE_ENV=development

# PostgreSQL connection string (local development without Docker).
# When running the API inside Docker Compose, the container overrides this to:
#   postgresql://sabz:sabz@postgres:5432/sabz?schema=public
DATABASE_URL=postgresql://sabz:sabz@localhost:5432/sabz?schema=public

# Redis connection (local development without Docker).
# When running the API inside Docker Compose, the container overrides this to:
#   REDIS_HOST=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT authentication secrets. Must be long random strings; override in production.
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
