PORT=3000
NODE_ENV=development

# PostgreSQL connection string (local development without Docker).
# When running the API inside Docker Compose, the container overrides this to:
#   postgresql://sabz:sabz@postgres:5432/sabz?schema=public
DATABASE_URL=postgresql://sabz:sabz@localhost:5432/sabz?schema=public

# Redis connection (local development without Docker).
# When running the API inside Docker Compose, the container overrides this to:
#   REDIS_HOST=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT authentication secrets. Must be long random strings; override in production.
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated list of origins allowed to make credentialed (cookie) requests.
CORS_ORIGINS=http://localhost:5173

# Global API rate limiting (per IP, per route). Conservative defaults so that
# normal authenticated/admin usage is not blocked. Override in production.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Trusted reverse proxy hops for per-IP rate limiting (OTP and global).
# Leave unset (empty) when the API is reached directly. Set to "true" when a
# single reverse proxy / load balancer terminates client connections, or to
# a hop count / proxy address (e.g. "1", "loopback", "172.16.0.0/12").
# Per-IP limits (see the OTP abuse-prevention policy) are only as good as the
# client IP the application observes, so this must match the deployment.
TRUST_PROXY=

# Mobile number of the development-only admin user created by `prisma:seed`.
# Must be a valid Iranian mobile number. Never set this in production.
DEV_ADMIN_MOBILE=+989170000001

# Business document storage. Binary contents live outside PostgreSQL (metadata
# lives in the BusinessDocument table). 'local' stores files under
# DOCUMENT_STORAGE_DIR, resolved against the process working directory (the API
# package directory under `pnpm --filter @sabz/api ...`). Inside Docker Compose
# this directory is pinned to /app/.data/documents and backed by the
# api_documents volume.
DOCUMENT_STORAGE_DRIVER=local
DOCUMENT_STORAGE_DIR=.data/documents

# Product media storage (SS-105). Metadata lives in the ProductMedia table;
# binary contents are stored through the Product-domain ProductMediaStorage
# abstraction. 'local' stores files under PRODUCT_MEDIA_STORAGE_DIR, resolved
# against the process working directory. Inside Docker Compose this directory
# is pinned to /app/.data/product-media and backed by the api_product_media
# volume. Only the 'local' driver is implemented; object storage is future work.
PRODUCT_MEDIA_STORAGE_DRIVER=local
PRODUCT_MEDIA_STORAGE_DIR=.data/product-media

# Product media upload pipeline (SS-105). Uploads stream to a server-generated
# temp file (never a memory buffer) before validation and server-side
# watermarking; the temp dir defaults to <PRODUCT_MEDIA_STORAGE_DIR>/tmp and is
# swept of stale files at API startup. Size caps are per media type: images
# 10 MB, videos up to 200 MB.
# PRODUCT_MEDIA_TEMP_DIR=.data/product-media/tmp
# PRODUCT_MEDIA_IMAGE_MAX_SIZE_BYTES=10485760
# PRODUCT_MEDIA_VIDEO_MAX_SIZE_BYTES=209715200

# Inline rich-text description images (product long description): images only,
# default cap 5 MB.
# PRODUCT_DESCRIPTION_IMAGE_MAX_SIZE_BYTES=5242880

# Company watermarking / branding (CATALOG-007). Every uploaded product image
# and video is watermarked server-side with the logo + company name before it
# is stored; originals are never retained. Assets are bundled under
# apps/api/assets/watermark by default (see also the root .env.example).
# WATERMARK_ENABLED=true
# WATERMARK_COMPANY_NAME=سبز سیستم
# WATERMARK_LOGO_PATH=assets/watermark/logo-placeholder.svg
# WATERMARK_FONT_PATH=assets/watermark/fonts/Vazirmatn-Regular.ttf
# WATERMARK_OPACITY=0.55
# WATERMARK_POSITION=bottom-right
# WATERMARK_MARGIN_RATIO=0.04
# WATERMARK_SIZE_RATIO=0.3
# WATERMARK_MIN_SIZE_PX=140
# WATERMARK_MAX_SIZE_PX=360

# FFmpeg binary used by the video watermark processor. Defaults to `ffmpeg`
# found on PATH. Installed in the API Docker image and available in CI.
# FFMPEG_PATH=ffmpeg
