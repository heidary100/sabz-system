PORT=3000
NODE_ENV=development

# PostgreSQL connection string (local development without Docker).
# When running the API inside Docker Compose, the container overrides this to:
#   postgresql://sabz:sabz@postgres:5432/sabz?schema=public
DATABASE_URL=postgresql://sabz:sabz@localhost:5432/sabz?schema=public

# Redis connection (local development without Docker).
# When running the API inside Docker Compose, the container overrides this to:
#   REDIS_HOST=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT authentication secrets. Must be long random strings; override in production.
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated list of origins allowed to make credentialed (cookie) requests.
CORS_ORIGINS=http://localhost:5173

# Global API rate limiting (per IP, per route). Conservative defaults so that
# normal authenticated/admin usage is not blocked. Override in production.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Trusted reverse proxy hops for per-IP rate limiting (OTP and global).
# Leave unset (empty) when the API is reached directly. Set to "true" when a
# single reverse proxy / load balancer terminates client connections, or to
# a hop count / proxy address (e.g. "1", "loopback", "172.16.0.0/12").
# Per-IP limits (see the OTP abuse-prevention policy) are only as good as the
# client IP the application observes, so this must match the deployment.
TRUST_PROXY=

# Mobile number of the development-only admin user created by `prisma:seed`.
# Must be a valid Iranian mobile number. Never set this in production.
DEV_ADMIN_MOBILE=+989170000001
