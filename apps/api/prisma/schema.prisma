generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  // Dedicated shadow database for migrate/diff (session handoff §4.5):
  // never point Prisma shadow operations at the live dev database.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum UserStatus {
  PENDING_OTP
  ACTIVE
  SUSPENDED
  LOCKED
}

enum PartnerApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum PartnerDocumentType {
  BUSINESS_LICENSE
  NATIONAL_ID
  TAX_REGISTRATION
  SUPPORTING
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductCondition {
  NEW
  OPEN_BOX
  REFURBISHED
  USED
  STOCK_CLEARANCE
}

enum ProductMediaType {
  IMAGE
  VIDEO
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

enum InventoryMovementType {
  INITIAL_STOCK
  PURCHASE_RECEIPT
  SALE
  RESERVATION
  RESERVATION_RELEASE
  MANUAL_ADJUSTMENT
  DAMAGE
  RETURN_RECEIVED
  RETURN_REJECTED
  STOCK_TRANSFER
  HOLO_IMPORT
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
}

enum ImportRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum ImportRecordStatus {
  PENDING
  IMPORTED
  UPDATED
  SKIPPED
  FAILED
}

enum PriceStatus {
  PRICED
  CALL_FOR_PRICE
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  ONLINE
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

/// Scheduled-sale discount kind (SS-235 Round A). PERCENT is 0–100,
/// FIXED is a Rial amount off the (post-tier, post-bulk) unit price.
enum PromotionType {
  PERCENT
  FIXED
}

/// RFQ lifecycle (SS-235 B2, pricing-engine.md §6 + §8). PENDING = partner
/// request awaiting operator quote; QUOTED = operator priced with expiry;
/// ACCEPTED = partner accepted inside the window (order created);
/// REJECTED = operator declined; EXPIRED = window lapsed (lazy-marked on
/// read, hard-enforced on accept).
enum RfqStatus {
  PENDING
  QUOTED
  ACCEPTED
  REJECTED
  EXPIRED
}

/// Product-review moderation state (SS-236, master plan §5.8). PENDING =
/// awaiting operator moderation (invisible publicly); APPROVED = visible in
/// public reads and aggregates; REJECTED = operator declined, never visible.
/// There is no edit flow: authors file once per product (unique pair).
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Blog-article publication state (SS-238, master plan §5.10). DRAFT =
/// operator-only (invisible publicly, incl. archived rows); PUBLISHED =
/// visible in public reads. Public queries filter PUBLISHED in the query,
/// never in the component.
enum BlogStatus {
  DRAFT
  PUBLISHED
}

enum AttributeType {
  VARIANT_OPTION
  SPEC
}

model User {
  id           String     @id @default(uuid())
  mobile       String     @unique
  email        String?    @unique
  passwordHash String?
  status       UserStatus @default(PENDING_OTP)
  lastLoginAt  DateTime?

  profile  UserProfile?
  roles    UserRole[]
  sessions UserSession[]

  wishlistItems WishlistItem[]

  carts Cart[]

  addresses Address[]

  orders Order[]

  rfqs Rfq[]

  reviews Review[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@index([status])
}

model UserProfile {
  id        String @id @default(uuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String

  /// Personal/contact address of the individual user (e.g. for the profile
  /// endpoint). Distinct from Partner's business address; do not merge.
  address   String?
  avatarUrl String?

  partner Partner?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
}

model Partner {
  id                String      @id @default(uuid())
  profileId         String      @unique
  profile           UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  businessName      String
  businessLicenseNo String?
  nationalId        String?
  website           String?

  /// Business/legal operating address of the B2B partner entity, collected
  /// during the partner application. Distinct from UserProfile.address
  /// (the user's personal address); do not merge.
  address String?

  /// Business city; part of the partner business address. See Partner.address semantics.
  city            String?
  /// Business province; part of the partner business address. See Partner.address semantics.
  province        String?
  tierId          String?
  tier            PartnerTier?          @relation(fields: [tierId], references: [id])
  approvalStatus  PartnerApprovalStatus @default(DRAFT)
  approvedAt      DateTime?
  submittedAt     DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  reviewNotes     String?

  documents BusinessDocument[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@index([approvalStatus, submittedAt])
  @@index([tierId])
}

model PartnerTier {
  id               String  @id @default(uuid())
  name             String  @unique
  discountPercent  Decimal @db.Decimal(5, 2)
  minOrderQuantity Int

  partners Partner[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?
}

model BusinessDocument {
  id        String              @id @default(uuid())
  partnerId String
  partner   Partner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  type      PartnerDocumentType

  /// Display-only metadata. The binary file lives outside PostgreSQL; the
  /// server-generated storageKey must never be derived from this name.
  originalName String
  mimeType     String
  sizeBytes    Int
  storageKey   String @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@index([partnerId, deletedAt])
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  users       UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?
}

model Permission {
  id       String @id @default(uuid())
  name     String @unique
  resource String
  action   String

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?
}

model UserRole {
  userId     String
  roleId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())
  assignedBy String?

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  assignedAt   DateTime   @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserSession {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String    @unique
  deviceId     String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([userId])
}

model AuditLog {
  id        String  @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([entity, createdAt])
}

model Category {
  id       String     @id @default(uuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  sortOrder Int     @default(0)
  isVisible Boolean @default(true)

  products Product[]

  priceRules CategoryPriceRule[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@index([parentId])
  @@index([isVisible, deletedAt])
}

model Brand {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  /// English display name (SS-203). Replaces the former demo-seed hack of
  /// smuggling it inside `description`; `description` is now genuinely unused.
  nameEn      String?
  logoKey     String?
  isFeatured  Boolean @default(false)

  products Product[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
}

model Product {
  id               String  @id @default(uuid())
  name             String
  slug             String  @unique
  shortDescription String?
  description      String?

  /// Q2 (SS-207 sign-off): unbranded source rows import with a null brand;
  /// no synthetic "generic" brand is ever created. Null = genuinely
  /// unbranded (importer or operator-cleared), not missing data.
  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  warranty  String?
  condition ProductCondition
  status    ProductStatus    @default(DRAFT)

  weightKg      Decimal? @db.Decimal(8, 3)
  widthCm       Decimal? @db.Decimal(8, 2)
  heightCm      Decimal? @db.Decimal(8, 2)
  depthCm       Decimal? @db.Decimal(8, 2)
  originCountry String?

  /// English display name for mixed FA/EN rendering and search (SS-203).
  nameEn String?

  /// Secondary title line from the source catalog (SS-203).
  subtitle String?

  /// Public SEO fields (SS-203). Titles/descriptions migrate; scores and
  /// social-overlay settings stay in the documented ignore-list.
  /// focusKeyword is index-only for search (SS-216), never rendered.
  metaTitle       String?
  metaDescription String?
  focusKeyword    String?

  /// External-source identity (ADR-004). Set only by importers; never derived
  /// from slug or SKU. Null = created natively (admin UI, demo seed).
  /// Uniquely identifies one logical product across repeated imports.
  sourceSystem String?
  sourceId     String?
  sourceType   String?

  /// SS-217 denormalization: minimum price among live (deletedAt IS NULL)
  /// variants whose priceStatus is PRICED. compareAtPrice never contributes
  /// (it is a static reference price). NULL = no live priced variant
  /// (call-for-price product). Maintained transactionally by
  /// recomputeProductMinPrice() on every variant write; ordering indexes are
  /// partial raw-SQL objects in the ss_217 migration (Prisma cannot express
  /// partial indexes — same drift policy as SS-216, ADR-006).
  minPrice Decimal? @db.Decimal(12, 2)

  variants ProductVariant[]
  media    ProductMedia[]
  specs    ProductAttributeValue[]
  tags     ProductTag[]

  priceOverride ProductPriceOverride?

  wishlistItems WishlistItem[]

  reviews Review[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@unique([sourceSystem, sourceId])
  @@index([status, deletedAt])
  @@index([categoryId, deletedAt])
  @@index([brandId, deletedAt])
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku     String  @unique
  barcode String?
  name    String?

  price Decimal @db.Decimal(12, 2)

  /// Pre-discount reference price for sales (SS-201). Null = no sale.
  /// Only meaningful when priceStatus is PRICED; enforced in VariantsService.
  compareAtPrice Decimal? @db.Decimal(12, 2)

  /// Purchasability state (SS-201, Q1: visible call-for-price). CALL_FOR_PRICE
  /// rows (WooCommerce priceless records; importer writes price '0') are
  /// published but non-purchasable: never displayed, sorted, or faceted by
  /// price. Every price consumer must filter to PRICED first.
  priceStatus PriceStatus @default(PRICED)

  /// External-source identity (ADR-004). Same semantics as Product's source
  /// identity, but independent: a product and a variant may legitimately
  /// carry the same (sourceSystem, sourceId) pair from different source rows.
  sourceSystem String?
  sourceId     String?
  sourceType   String?

  media          ProductMedia[]
  inventoryItems InventoryItem[]
  options        VariantAttributeValue[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  rfqs           Rfq[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@unique([sourceSystem, sourceId])
  @@index([productId, deletedAt])
}

model ProductMedia {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  mediaType    ProductMediaType
  originalName String
  mimeType     String
  sizeBytes    Int

  storageKey String @unique

  /// Origin URL the bytes were fetched from (SS-204). Set by bulk importers;
  /// null for direct admin uploads. Unique per product: re-importing the same
  /// URL updates instead of duplicating (importer skip-checks via lookup).
  sourceUrl String?

  /// SHA-256 (hex) of the received source bytes, always server-computed
  /// (SS-204). Identifies source bytes, not the watermarked derivative, so
  /// watermark retuning never breaks dedup. Enables cross-product reuse
  /// detection; null only for rows predating SS-204.
  contentHash String?

  /// Server-generated key of the watermarked thumbnail derivative (SS-129).
  /// Images only; null = no thumbnail (videos, or images predating SS-129
  /// that were not backfilled). Consumers fall back to the original asset.
  thumbnailKey       String?
  thumbnailSizeBytes Int?

  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@unique([productId, sourceUrl])
  @@index([contentHash])
  @@index([productId, deletedAt])
  @@index([productId, sortOrder])
  @@index([variantId])
}

model Warehouse {
  id           String          @id @default(uuid())
  code         String          @unique
  name         String
  address      String?
  contactName  String?
  contactPhone String?
  status       WarehouseStatus @default(ACTIVE)

  inventoryItems InventoryItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  @@index([status, deletedAt])
}

model InventoryItem {
  id               String         @id @default(uuid())
  warehouseId      String
  warehouse        Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantityOnHand   Int            @default(0)
  quantityReserved Int            @default(0)
  reorderLevel     Int?
  criticalLevel    Int?

  movements    InventoryMovement[]
  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@unique([variantId, warehouseId])
  @@index([warehouseId])
}

model InventoryMovement {
  id              String                @id @default(uuid())
  inventoryItemId String
  inventoryItem   InventoryItem         @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  variantId       String
  warehouseId     String
  type            InventoryMovementType
  quantity        Int
  reservedDelta   Int                   @default(0)
  reason          String?
  notes           String?
  reference       String?
  onHandBefore    Int
  onHandAfter     Int
  reservedBefore  Int                   @default(0)
  reservedAfter   Int                   @default(0)
  createdAt       DateTime              @default(now())
  createdBy       String?

  @@index([inventoryItemId, createdAt])
  @@index([variantId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
}

model Reservation {
  id              String            @id @default(uuid())
  inventoryItemId String
  inventoryItem   InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  quantity        Int
  status          ReservationStatus @default(ACTIVE)
  expiresAt       DateTime?
  releasedAt      DateTime?
  consumedAt      DateTime?
  expiredAt       DateTime?
  createdAt       DateTime          @default(now())
  createdBy       String?
  updatedBy       String?

  @@index([inventoryItemId])
  @@index([status, expiresAt])
}

/// One execution of an external-catalog import (ADR-004). Persistence
/// foundation only; the importer itself is a later issue. Runs are
/// append-only audit: never soft-deleted, never reused across sources.
model ImportRun {
  id           String          @id @default(uuid())
  sourceSystem String
  status       ImportRunStatus @default(RUNNING)
  startedAt    DateTime        @default(now())
  finishedAt   DateTime?
  error        String?

  records ImportRecord[]

  @@index([sourceSystem, startedAt])
}

/// Per-source-row audit trail for one ImportRun (ADR-004).
///
/// `sourceData` holds a bounded snapshot of the original external row for
/// auditing, troubleshooting, future field mappings, and change detection.
/// It is importer-owned and never read by commerce logic: the normalized
/// Product/ProductVariant domain must not grow an arbitrary JSON blob.
/// `productId`/`variantId` are plain (non-FK) references so the audit trail
/// survives later catalog deletes.
model ImportRecord {
  id            String             @id @default(uuid())
  runId         String
  run           ImportRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceSystem  String
  sourceId      String
  sourceType    String?
  sourceRowHash String?
  status        ImportRecordStatus @default(PENDING)
  attempts      Int                @default(0)
  error         String?
  sourceData    Json?
  productId     String?
  variantId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([runId, sourceSystem, sourceId])
  @@index([runId, status])
  @@index([sourceSystem, sourceId])
  @@index([productId])
  @@index([variantId])
}

/// Reusable attribute definition (ADR-005, SS-202).
///
/// Two roles, distinguished by `type`: VARIANT_OPTION attributes define a
/// purchasable variation axis (e.g. color) and are assigned to variants;
/// SPEC attributes describe a product (e.g. CPU, capacity) and are assigned
/// to products for display and (when `isFilterable`) faceted search.
/// Reference data: hard-deleted when unused (service-guarded); the audit
/// trail for importer-created rows lives in ImportRecord, not here.
model Attribute {
  id           String        @id @default(uuid())
  name         String        @unique
  slug         String        @unique
  type         AttributeType
  group        String?
  isFilterable Boolean       @default(false)
  isGlobal     Boolean       @default(false)

  values AttributeValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, isFilterable])
}

/// One allowed value of an Attribute (ADR-005). Values are per-attribute
/// (the same display string under two attributes is two rows).
model AttributeValue {
  id          String    @id @default(uuid())
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  value       String
  slug        String

  productSpecs ProductAttributeValue[]
  variantUses  VariantAttributeValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attributeId, value])
  @@index([attributeId])
}

/// Display/Filterable spec assignment of a value to a product (ADR-005).
/// `source` records which importer parser produced the row (e.g. WOO_ATTR
/// for numbered WooCommerce attributes, WOO_CUSTOM for custom_attributes
/// lines); open vocabulary, see the WOO_* constants in AttributesService.
/// Derived rows: hard-deleted on unassign or with the product.
model ProductAttributeValue {
  id               String         @id @default(uuid())
  productId        String
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)
  sortOrder        Int            @default(0)
  source           String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, attributeValueId])
  @@index([productId, sortOrder])
}

/// Variant-defining option assignment (ADR-005). Set semantics: a variant
/// holds at most one value per attribute (enforced in AttributesService).
model VariantAttributeValue {
  id               String         @id @default(uuid())
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([variantId, attributeValueId])
  @@index([variantId])
}

/// Normalized product tag (SS-203).
///
/// `name` is the first-seen display form; `key` is the comparison form
/// (spaces/ZWNJ stripped, Arabic letters folded, Latin lowercased) so
/// Persian spelling variants (لپ تاپ / لپتاپ / لپ‌تاپ) converge to one row
/// without a manual alias map. Reference data: hard-deleted when unused
/// (service-guarded); importer provenance lives in ImportRecord.
model Tag {
  id   String @id @default(uuid())
  name String
  key  String @unique
  slug String @unique

  products ProductTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Customer wishlist entry (SS-231). One row per (user, product) pair;
/// hard-deleted on remove or with the user/product (both cascades).
/// Only PUBLISHED, non-deleted products are ever listed — enforced in
/// WishlistService, not by the schema; stale rows vanish via cascade.
model WishlistItem {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, createdAt])
}

/// Customer shopping cart (SS-232). One row per authenticated user
/// (CART-001); auto-created on first add. Lines live in CartItem keyed by
/// variant; the cart row itself carries no money — totals are derived.
/// Hard-deleted with the user (cascade); cleared explicitly, never by the
/// schema. Guests have no server cart (localStorage + replay merge).
model Cart {
  id     String     @id @default(uuid())
  userId String     @unique
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One cart line (SS-232): a variant + quantity + the add-time unit-price
/// snapshot (`unitPriceAtAdd`, Rial, display only — the live variant price
/// is the line truth per CART-003). Hard-deleted on remove/clear or with
/// the cart/variant (all cascades); stale lines vanish instead of lingering.
model CartItem {
  id             String         @id @default(uuid())
  cartId         String
  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity       Int
  unitPriceAtAdd Decimal        @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, variantId])
  @@index([cartId, createdAt])
}

/// Customer address-book entry (SS-233). Many rows per user; exactly one
/// row may carry `isDefault` (enforced in the service transaction, not the
/// schema, so the "first address becomes default" flow stays race-safe).
/// Orders snapshot the chosen address columns at creation (ORDER-003) and
/// never read back from this table, so later edits cannot rewrite history.
model Address {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label      String?
  fullName   String
  phone      String
  province   String?
  city       String?
  address    String
  postalCode String?
  isDefault  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

/// Customer order (SS-233). The address columns are a creation-time snapshot
/// of the chosen address-book entry (ORDER-003 immutability); money is Rial
/// verbatim (SS-207 "O-1"). `orderNumber` comes from the global
/// `sabz_order_number_seq` sequence (unique + sequential per spec §7).
/// Status is the v1 subset PENDING → PROCESSING → SHIPPED → DELIVERED plus
/// CANCELLED; customers may only move PENDING → CANCELLED, operators own the
/// rest (SS-240). Hard-deleted with the user (cascade); never edited
/// except through approved state transitions (ORDER-002).
model Order {
  id          String      @id @default(uuid())
  orderNumber Int         @unique
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      OrderStatus @default(PENDING)

  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)

  subtotal    Decimal @db.Decimal(12, 2)
  shippingFee Decimal @default(0) @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  fullName   String
  phone      String
  province   String?
  city       String?
  address    String
  postalCode String?

  items OrderItem[]

  rfq Rfq?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// One order line (SS-233). A creation-time snapshot of the variant
/// (ORDER-003/004): names, SKU, unit price and line total are frozen and
/// never updated from catalog changes. One row per (variant, warehouse)
/// allocation slice, so a variant split across warehouses appears twice;
/// `warehouseId` records where the stock was consumed for cancel-restock.
/// Hard-deleted with the order (cascade).
model OrderItem {
  id          String         @id @default(uuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouseId String

  productName String
  variantName String?
  sku         String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  @@index([orderId])
  @@index([variantId])
}

/// Tag assignment preserving source ordering (SS-203). Derived rows:
/// hard-deleted on unassign or with the product.
model ProductTag {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, tagId])
  @@index([productId, sortOrder])
  @@index([tagId])
}

/// Scheduled sale / promotion (SS-235 Round A, pricing-engine.md §6).
/// Applied server-side after tier + bulk in `PricingService.resolveLine`;
/// the storefront never computes discounts. Scope is optional and
/// narrowest-wins: productId > categoryId > brandId > sitewide (all null).
/// Admin CRUD arrives with SS-240; until then rows are managed via seed or
/// direct DB writes. Invalid rows (bad range, endsAt <= startsAt) are
/// ignored by the resolver, never fatal.
model Promotion {
  id    String        @id @default(uuid())
  code  String        @unique
  titleFa String
  type  PromotionType
  /// PERCENT: 0–100. FIXED: Rial amount off.
  value   Decimal  @db.Decimal(12, 2)
  startsAt DateTime
  endsAt   DateTime
  isActive Boolean  @default(true)

  productId  String?
  categoryId String?
  brandId    String?

  /// Minimum line quantity for the promotion to apply.
  minQuantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([isActive, startsAt, endsAt])
  @@index([productId])
  @@index([categoryId])
  @@index([brandId])
}

/// Category pricing rule (SS-235 Round B1, pricing-engine.md §5–§6).
/// Adjusts the base price of every product in the category BEFORE the
/// partner tier step (chain: Base → CategoryRule → Override → Tier →
/// Bulk → Promotion). At most one rule applies per line: lowest
/// `priority` wins, ties break by newest `createdAt`. PERCENT is 0–100
/// off the running base; FIXED is a Rial amount off. Cost-based formulas
/// (cost + markup) are not modeled — there is no cost column yet.
/// Admin CRUD arrives with SS-240; until then rows are managed via seed
/// or direct DB writes. Inactive, out-of-window, or invalid rows are
/// ignored by the resolver, never fatal.
model CategoryPriceRule {
  id         String        @id @default(uuid())
  categoryId String
  category   Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  type       PromotionType
  /// PERCENT: 0–100. FIXED: Rial amount off.
  value    Decimal  @db.Decimal(12, 2)
  isActive Boolean  @default(true)
  startsAt DateTime?
  endsAt   DateTime?

  /// Lower wins when several rules cover the same category.
  priority Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([categoryId, isActive])
}

/// Product-specific price override (SS-235 Round B1). Applies AFTER the
/// category rule for exactly one product (spec §5 order) with the same
/// PERCENT|FIXED-off semantics. At most one row per product (`productId`
/// unique); inactive, out-of-window, or invalid rows are ignored, never
/// fatal. Admin CRUD arrives with SS-240.
model ProductPriceOverride {
  id        String        @id @default(uuid())
  productId String        @unique
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      PromotionType
  /// PERCENT: 0–100. FIXED: Rial amount off.
  value    Decimal  @db.Decimal(12, 2)
  isActive Boolean  @default(true)
  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([productId, isActive])
}

/// Request for quotation (SS-235 B2, pricing-engine.md §6 + §8). Only
/// APPROVED partners may file, and only against CALL_FOR_PRICE variants
/// (PRICE-008: RFQ products stay non-purchasable until a quotation is
/// accepted). The operator quote (`quotedUnitPrice`, Rial verbatim) is the
/// price agreement: accept freezes it into an order via
/// `CheckoutService.placeQuotedOrder` — it never flows through
/// `PricingService.resolveLine`. `expiresAt` defaults to 7 days
/// (configurable per quote); expiry is lazy-marked on read and
/// hard-enforced on accept. One row converts to at most one order
/// (`orderId` unique). Audit trail lives in AuditLog (rfq.created,
/// rfq.quoted, rfq.accepted, rfq.expired, rfq.rejected); operator
/// attribution reuses createdBy/updatedBy + quotedBy.
model Rfq {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity  Int
  status    RfqStatus @default(PENDING)

  /// Operator-quoted unit price in Rial (null until QUOTED).
  quotedUnitPrice Decimal? @db.Decimal(12, 2)
  expiresAt       DateTime

  /// Order created by accept (null until ACCEPTED).
  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  quotedBy String?
  quotedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([variantId])
}

/// Product review (SS-236, master plan §5.8). One row per (user, product)
/// pair (`@@unique`); authors file once, there is no edit flow. Only
/// PUBLISHED, non-deleted products are reviewable — enforced in
/// ReviewsService, not by the schema. Only APPROVED rows are publicly
/// visible or aggregated; PENDING/REJECTED rows are moderation state.
/// Hard-deleted with the user or product (both cascades). Audit trail lives
/// in AuditLog (REVIEW_CREATED / APPROVED / REJECTED, entity 'Review').
model Review {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Integer star rating, 1–5 (validated in the DTO).
  rating Int

  /// Optional comment, max 2000 characters (validated in the DTO).
  comment String?

  status ReviewStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@unique([userId, productId])
  @@index([productId, status, createdAt])
  @@index([status, createdAt])
}

/// Blog category (SS-238, master plan §5.10). Optional filing for posts;
/// operators manage rows via /blog/categories (full admin UI in SS-240).
model BlogCategory {
  id          String  @id @default(uuid())
  slug        String  @unique
  name        String
  description String?
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts BlogPost[]

  @@index([sortOrder])
}

/// Blog article (SS-238, master plan §5.10). Bodies are allowlist-sanitized
/// HTML (same sanitizer as product descriptions). The author byline is a
/// plain display string — no User FK. Audit trail lives in AuditLog
/// (BLOG_CREATED / UPDATED / ARCHIVED / CATEGORY_* , entity
/// 'BlogPost'/'BlogCategory').
model BlogPost {
  id         String        @id @default(uuid())
  slug       String        @unique
  categoryId String?
  category   BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  title       String
  excerpt     String?
  /// Sanitized HTML body.
  content     String
  coverImageUrl String?
  authorName  String?

  metaTitle       String?
  metaDescription String?

  status BlogStatus @default(DRAFT)
  /// Display/publish timestamp; set automatically on publish when omitted.
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([status, publishedAt])
  @@index([categoryId, status, publishedAt])
}
