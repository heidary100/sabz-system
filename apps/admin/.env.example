# Base URL of the Sabz System API as seen from the browser.
# With the Docker development environment the API is exposed on the host at port 3000.
# When unset, requests go to the Vite dev server proxy (/api/v1 -> http://localhost:3000).
# Production: use /api/v1 behind the admin host's same-origin proxy, or a
# dedicated admin API host. Never the storefront's cookie-issuing API origin
# (the refresh cookie is host-only; see deploy-runbook §1 / SS-290).
VITE_API_BASE_URL=http://localhost:3000/api/v1
