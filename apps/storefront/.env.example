# Base URL of the Sabz System API as seen from the browser. Next.js inlines
# NEXT_PUBLIC_* variables at build time, so this is read from this file (or
# the process environment) when the dev server / build runs — a root `.env`
# is never read by Next.js.
#
# Values may be an absolute http(s) origin or a root-relative same-origin
# path such as /api/v1 when the storefront host proxies the API. A relative
# value is never silently turned into a localhost URL.
# Optional in development only; production builds require an explicit value.
# With the Docker development environment the API is exposed on the host at
# port 3000, so no override is needed there.
# Never use the admin's cookie-issuing API origin (the refresh cookie is
# host-only; see deploy-runbook §1 / SS-290).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Optional. Defaults to NEXT_PUBLIC_API_BASE_URL. Absolute origins are
# allow-listed for next/image; a root-relative value keeps image requests
# same-origin. The image optimizer must be able to reach an absolute upstream
# or the storefront host must proxy the relative media path.
# NEXT_PUBLIC_MEDIA_BASE_URL=http://api:3000/api/v1

# Server-side API origin for Next server components. Must be an absolute
# http(s) URL. When omitted, an absolute NEXT_PUBLIC_API_BASE_URL is reused;
# a root-relative browser base requires this explicit internal origin.
# API_INTERNAL_BASE_URL=http://api:3000/api/v1

# Public origin of the storefront itself, used for absolute OG/canonical URLs,
# JSON-LD ids and social-share links (SS-209/SS-248). Fallback chain when
# unset (apps/storefront/src/lib/site-url.ts): https://<VERCEL_URL> on Vercel
# deployments, else the browser-visible dev origin http://localhost:3002.
# Set it explicitly in every non-local deployment — share links built on a
# wrong origin are dead links.
# NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Shared secret for the POST /api/revalidate cache-invalidation endpoint
# (SS-217). The API presents it in the x-revalidate-token header; it must
# match the API's STOREFRONT_REVALIDATE_TOKEN (in Compose both come from the
# root REVALIDATE_TOKEN). When unset the endpoint refuses every request.
REVALIDATE_TOKEN=dev_revalidate_secret_change_me
