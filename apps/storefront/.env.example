# Base URL of the Sabz System API as seen from the browser. Next.js inlines
# NEXT_PUBLIC_* variables at build time, so this is read from this file (or
# the process environment) when the dev server / build runs — a root `.env`
# is never read by Next.js.
#
# Optional: when unset, the storefront code falls back to the development
# default http://localhost:3000/api/v1 (see apps/storefront/src/lib/api.ts).
# With the Docker development environment the API is exposed on the host at
# port 3000, so no override is needed there.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Public origin of the storefront itself, used only as `metadataBase` for
# absolute OG/canonical URLs (SS-209). Optional: defaults to the local dev
# origin when unset.
# NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Shared secret for the POST /api/revalidate cache-invalidation endpoint
# (SS-217). The API presents it in the x-revalidate-token header; it must
# match the API's STOREFRONT_REVALIDATE_TOKEN (in Compose both come from the
# root REVALIDATE_TOKEN). When unset the endpoint refuses every request.
REVALIDATE_TOKEN=dev_revalidate_secret_change_me
