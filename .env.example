# Sabz System — root environment configuration
#
# This file documents every environment variable the monorepo consumes and
# which application owns each variable. It is the single development
# environment contract for the repository.
#
# HOW IT IS USED
# -------------
# Docker Compose reads this file automatically when a `.env` copy exists at
# the repository root (`cp .env.example .env`). Compose uses the values for
# ${VAR} interpolation in docker-compose.yml — it does NOT inject a root
# `.env` into containers on its own; the `environment:` block in
# docker-compose.yml passes each value to the relevant service.
#
# The application frameworks do NOT read the root `.env` when running on the
# host:
#   - NestJS reads apps/api/.env            (apps/api/.env.example)
#   - Vite reads apps/admin/.env            (apps/admin/.env.example)
#   - Next.js reads apps/storefront/.env*   (apps/storefront/.env.example)
#   - Prisma reads DATABASE_URL from the package .env / process environment
# Keep application-level examples in sync with this contract.
#
# SAFE DEFAULTS vs MUST SUPPLY
# ----------------------------
# Every value below is a safe local-development default, so `docker compose
# up` works with zero configuration. None of them is a real secret.
#
# MUST be overridden outside local development:
#   - JWT_ACCESS_SECRET / JWT_REFRESH_SECRET (long random strings)
#   - POSTGRES_PASSWORD / DATABASE_URL
#   - CORS_ORIGINS
#   - DEV_ADMIN_MOBILE is development-only by design
#
# Nothing here may be used in production.

# ---------------------------------------------------------------------------
# Shared / infrastructure (Docker Compose only)
# ---------------------------------------------------------------------------

# PostgreSQL credentials used by the postgres service. Changing these
# automatically rewrites the API's DATABASE_URL inside Compose (it is built
# from these variables). Keep the password URL-safe (no @ : / characters) or
# encode it, and remember that host-native API runs read DATABASE_URL from
# apps/api/.env — update that file in sync when you override these.
POSTGRES_USER=sabz
POSTGRES_PASSWORD=sabz
POSTGRES_DB=sabz

# ---------------------------------------------------------------------------
# API-only variables
# ---------------------------------------------------------------------------
# Owned by apps/api. Documented here because Docker Compose injects them into
# the api service. For host-native development, copy apps/api/.env.example to
# apps/api/.env — the values there are the authoritative API defaults.
#
# NODE_ENV=development and PORT=3000 are pinned by docker-compose.yml (NODE_ENV
# gates the Swagger UI and the seed script) and are not overridable there.
#
# Compose overrides the host values with the values below. Inside the Compose
# network, DATABASE_URL always points at the `postgres` service and
# REDIS_HOST is the `redis` service name (neither is host-configurable).

# PostgreSQL connection string used by Prisma and the API runtime. Must be
# supplied in any environment where migrations or seeding run. Inside Docker
# Compose it is derived from the POSTGRES_* variables above — do not set it
# here; the effective local default is:
#   postgresql://sabz:sabz@postgres:5432/sabz?schema=public
# For host-native development it lives in apps/api/.env.

# Redis connection. REDIS_HOST and REDIS_PORT are pinned by docker-compose.yml
# (the Compose service name and default port) and are not overridable there.
REDIS_HOST=redis
REDIS_PORT=6379
# The local Compose Redis has no password configured. Setting a password here
# requires configuring the redis service to require it too.
REDIS_PASSWORD=

# JWT secrets. Development placeholders only — must be long random strings in
# any non-local environment.
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me

# JWT token lifetimes (see the authentication specification).
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated origins allowed to make credentialed (cookie) requests.
CORS_ORIGINS=http://localhost:5173

# Global API rate limiting (per IP, per route). Conservative development
# defaults; override in production.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Trusted reverse proxy hops for per-IP rate limiting (OTP and global).
# Leave unset when the API is reached directly; set to "true" (or a hop
# count / proxy address) when a reverse proxy terminates client connections.
# Per-IP limits are only as good as the client IP the API observes.
TRUST_PROXY=

# Mobile number of the development-only admin created by `prisma:seed`
# (must be a valid Iranian mobile number). The seed refuses to run unless
# NODE_ENV=development. Never use this in production.
DEV_ADMIN_MOBILE=+989170000001

# ---------------------------------------------------------------------------
# Admin-only variables
# ---------------------------------------------------------------------------
# Owned by apps/admin and inlined by Vite at build time. Documented here
# because Docker Compose injects it into the admin service. For host-native
# development, copy apps/admin/.env.example to apps/admin/.env.
# When unset, requests go to the Vite dev-server proxy (/api/v1).

# Base URL of the Sabz System API as seen from the browser.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# ---------------------------------------------------------------------------
# Storefront-only variables
# ---------------------------------------------------------------------------
# Owned by apps/storefront and inlined by Next.js at build time. Docker
# Compose does not set it: the storefront code falls back to the development
# default shown below. For host-native development, copy
# apps/storefront/.env.example to apps/storefront/.env.local if you need to
# override the default.

# Base URL of the Sabz System API as seen from the browser.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
